/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nano-assembler-nf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input/Output options
    input              = null
    outdir             = "${launchDir}/output"

    // Porechop Parameters
    // Skip adapter trimming for reads that were already chopped (or basecalled
    // with dorado, which trims adapters itself).
    skip_porechop      = false

    // Filtlong Parameters
    min_length         = 1000
    min_mean_q         = 90

    // Assembly Parameters
    assembler          = 'necat'   // 'necat' or 'flye'
    coverage           = 80        // NECAT PREP/CNS output coverage
    purge_dups         = false     // purge haplotigs from a diploid assembly

    // Medaka Parameters
    model              = "r1041_e82_400bps_sup_g615"

    // BUSCO Parameters
    lineage            = "ascomycota_odb10"

    // Tapestry Parameters
    // Telomere repeat unit. The default is the vertebrate motif; fungal
    // telomeres vary widely, so set this per species.
    telomere           = "TTAGGG"

    // Kraken2 Parameters
    // Path to a Kraken2 database directory. Contamination screening is skipped
    // if not supplied. See the README for how to obtain one.
    kraken2_db         = null

    // BLAST Parameters
    // Directory holding a BLAST nucleotide database named `mito`. Organelle
    // identification is skipped if not supplied.
    mito_db            = null

    // MultiQC options
    multiqc_config     = null

    // Timestamp for pipeline_info filenames. A params entry rather than a
    // `def`, which the strict config syntax does not allow.
    trace_timestamp    = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    
    // Max resource options
    // Defaults only, expected to be overwritten
    max_memory         = '128.GB'
    max_cpus           = 16
    max_time           = '240.h'
}

// Global process config
process {
    // Built-in ceiling on every request, replacing the old check_max() helper.
    // Functions are not permitted in config files under the strict syntax.
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    cpus   = { 1 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Retry OOM/kill codes, and also failures where no exit status could be
    // read: a node-side SLURM prolog failure reports no status and would
    // otherwise abort a whole run at its first task.
    errorStrategy = { task.exitStatus == null ||
                      task.exitStatus == Integer.MAX_VALUE ||
                      task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // QC that nothing downstream depends on. Retry the same recoverable cases
    // as above, but once retries are spent, drop the task instead of ending the
    // run -- a failed BUSCO should not discard hours of completed assembly.
    // Failures still appear in the execution report and the pipeline log.
    withLabel: optional_qc {
        errorStrategy = { (task.exitStatus == null ||
                           task.exitStatus == Integer.MAX_VALUE ||
                           task.exitStatus in [143,137,104,134,139]) &&
                          task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
    }

    // Process-specific resource requirements.
    //
    // Sized from measured peak RSS across four SC5314 runs (14.3 Mb genome),
    // at roughly 2x observed peak. Over-requesting is a policy matter on this
    // cluster, not just waste. Larger genomes will need more: re-check with
    // `seff` / the execution trace rather than scaling these blindly.
    withName: BUSCO {
        // observed 1.7 GB, 4.5 cores
        cpus   = { 8 * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: COVERAGE {
        // observed 2.3 GB; minimap2 was pinned to 1 cpu by the default
        cpus   = { 4 * task.attempt }
        memory = { 6.GB * task.attempt }
    }
    withName: FILTLONG {
        // observed 0.3 GB, single-threaded
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: JELLYFISH {
        // observed 3.5 GB; the -s 1G hash is the floor
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: KRAKEN2 {
        // observed 13.6 GB -- set by the 16 GB database, not the query
        cpus   = { 2 * task.attempt }
        memory = { 18.GB * task.attempt }
    }
    withName: MEDAKA {
        // observed 8.2 GB
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
    }
    withName: MERQURY {
        // observed 4.6 GB
        cpus   = { 4 * task.attempt }
        memory = { 10.GB * task.attempt }
    }
    withName: NANOPLOT {
        // observed 2.3 GB
        cpus   = { 4 * task.attempt }
        memory = { 6.GB * task.attempt }
    }
    withName: NECAT {
        // observed 25.0 GB, 13 cores -- the one process sized about right
        cpus   = { 16 * task.attempt }
        memory = { 40.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: FLYE {
        // observed 13.1 GB, 9.8 cores
        cpus   = { 16 * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: PURGE_DUPS {
        // observed 1.1 GB, 6.7 cores
        cpus   = { 8 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: PORECHOP {
        // NOT MEASURED -- skipped in every run so far. Left at the original
        // request; confirm with `seff` the first time it actually runs.
        cpus   = { 4 * task.attempt }
        memory = { 30.GB * task.attempt }
    }
    withName: RACON {
        // observed 5.1 GB
        cpus   = { 4 * task.attempt }
        memory = { 12.GB * task.attempt }
    }
    withName: TAPESTRY {
        // observed 3.8 GB, single-threaded in practice
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}

profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    test { includeConfig 'conf/test.config' }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        // Without a shared cache every new --outdir re-pulls each image into work/
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR')
                              ?: System.getenv('APPTAINER_CACHEDIR')
                              ?: "${System.getenv('HOME')}/.apptainer"
    }
    slurm {
        process.executor       = 'slurm'
        // Queue must satisfy BOTH limits: short caps at 6 h, medium at 24 h.
        // Selecting on memory alone sends 8 h retries to a 6 h partition.
        process.queue          = { task.time <= 6.h  && task.memory <= 10.GB ? 'short'
                                 : task.time <= 24.h && task.memory <= 40.GB ? 'medium'
                                 : 'long' }
    }
}

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'nano-assembler-nf'
    author          = 'Jordan Price'
    homePage        = 'https://github.com/jnprice/nano-assembler-nf'
    description     = 'Nextflow pipeline for Oxford Nanopore assembly and QC'
    mainScript      = 'main.nf'
    // resourceLimits requires 24.04+
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_timestamp}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_timestamp}.html"
}
