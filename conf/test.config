/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Smoke-test profile: Candida albicans SC5314
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Usage:
        # full run on the cluster
        sbatch nano-assembler-nf.sh assets/samplesheet_test.csv ./results_sc5314 -profile test

        # plumbing only, no compute
        nextflow run main.nf -profile test,singularity -stub-run --outdir ./stub

    The read set predates R10.4.1 (sequenced March 2022) and lives under a
    `porechop/` directory, so it is already adapter-trimmed. Both the model
    override and the porechop skip below follow from that -- the pipeline
    defaults target modern R10.4.1 sup data.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // No `illumina` column in the test samplesheet, so Merqury is skipped --
    // that is the intended behaviour, not a missing result.
    input         = "${projectDir}/assets/samplesheet_test.csv"

    skip_porechop = true
    model         = 'r941_min_sup_g507'

    // Saccharomycetes is a much tighter lineage than ascomycota for Candida.
    lineage       = 'saccharomycetes_odb10'

    // C. albicans telomere repeat unit (23 bp), not the vertebrate TTAGGG.
    telomere      = 'ACGGATGTCTAACTTCTTGGTGT'
}
